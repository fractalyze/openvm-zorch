frx-cuda12-pjrt==0.10.2.dev20260818233737
frx-cuda12-plugin==0.10.2.dev20260818233737
zk-dtypes==0.0.10

# The symmetric layer (permutations, sponges, compressions). It sits BELOW
# `zorch`, which imports it rather than owning a copy, so this repo takes it
# directly rather than through `zorch` — the same distribution-name rule as frx
# above applies: the name must track what the `zorch` pin depends on.
hash-frx==0.2.0.dev20260819071642

